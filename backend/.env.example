# Copie este arquivo para ".env" e ajuste os valores localmente.
# ".env" nunca é commitado (ver .gitignore na raiz do projeto).

# --- Banco de dados ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estacionamento

# --- Servidor ---
PORT=3000

# --- Autenticação ---
# Segredo usado pra assinar/verificar o token JWT. Gere um valor aleatório
# (ex: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# — nunca deixe o default abaixo em produção.
JWT_SECRET=troque-este-valor-antes-de-usar-em-producao
# Validade do token — decisão de operação, não constante no código.
JWT_EXPIRES_IN=12h

# --- Notificação automática ---
# Intervalo é configuração, não constante no código (ver CLAUDE.md).
# Expressão cron para o node-cron consultar movimentações em aberto.
NOTIFICACAO_INTERVALO_CRON=*/15 * * * *
# Tempo de permanência (em horas) a partir do qual a notificação é disparada.
NOTIFICACAO_LIMITE_HORAS=4

# --- Spike de teste do WhatsApp (backend/scripts/spike-whatsapp.js) ---
# Número que recebe a mensagem de teste. Só dígitos, com DDI+DDD (ex: 5551999998888).
# Use o SEU número aqui — o chip reserva é quem ENVIA, não quem recebe.
WHATSAPP_TESTE_DESTINO=
